# Public defaults. Copy to .env.local (git-ignored) for local use.
ARC_NETWORK=testnet
# Optional override; leave empty to use config/arc-networks.json.
ARC_RPC_URL=
# Burner deployer key for scripts that send transactions. Set it only in .env.local, never here.
DEPLOYER_PRIVATE_KEY=
# Testnet-only learner wallet for scripts/run-journey.mjs. Set it only in .env.local.
LEARNER_PRIVATE_KEY=
